# Downloaded corpora -- large, and reproducible from the shard IDs in the README.
data/
!data/.gitkeep
# ...but keep the small derived result files: the analyses and figures
# regenerate from these without re-downloading the corpus.
!data/*.json

# Third-party papers downloaded for the literature review. Copyrighted;
# must not be redistributed in the artifact.
papers/

# Generated outputs are tracked so a clone reproduces the paper's figures
# without re-running anything; regenerate with `python analysis/figures.py`.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Anything holding local identity for the anonymity scanner -- never commit.
anon_needles.txt
